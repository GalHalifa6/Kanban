<Window x:Class="Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="0,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="29*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button x:Name="Register" Content="Register" HorizontalAlignment="Left" Margin="48,156,0,0" VerticalAlignment="Top" Click="Register_Click" Grid.Row="1"/>
        <Button x:Name="Login" Content="Login" HorizontalAlignment="Left" Margin="112,102,0,0" VerticalAlignment="Top" Click="Login_Click" Grid.Row="1"/>
        <TextBox x:Name="LoginEmail" HorizontalAlignment="Left" Margin="85,50,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"  Grid.Row="1"/>
        <TextBox x:Name="LoginPassword" HorizontalAlignment="Left" Margin="85,73,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Grid.Row="1"/>
        <Label Content="Email" HorizontalAlignment="Left" Margin="42,42,0,0" VerticalAlignment="Top" Grid.Row="1"/>
        <Label x:Name="Password" Content="Password" HorizontalAlignment="Left" Margin="15,68,0,0" VerticalAlignment="Top" Height="24" Width="65" Grid.Row="1"/>

    </Grid>
</Window>
