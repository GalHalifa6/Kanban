<Window x:Class="Frontend.View.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.View"
        mc:Ignorable="d"
        Title="RegisterView" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="RegisterPassword" HorizontalAlignment="Left" Margin="400,178,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="RegisterButton" Content="Register" HorizontalAlignment="Left" Margin="430,202,0,0" VerticalAlignment="Top" Click="RegisterButton_Click"/>
        <TextBox x:Name="RegisterEmail" HorizontalAlignment="Left" Margin="400,155,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label Content="Email" HorizontalAlignment="Left" Margin="343,152,0,0" VerticalAlignment="Top" Height="24" Width="42"/>
        <Label Content="Password" HorizontalAlignment="Left" Margin="333,172,0,0" VerticalAlignment="Top" Height="24" Width="62"/>

    </Grid>
</Window>
